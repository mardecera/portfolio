---
import SkillCard, { getSkills } from "@entities/skill"
import PcIcon from "@icons/pc.svg"
import RocketIcon from "@icons/rocket.svg"
import ToolIcon from "@icons/tool.svg"
import { useTranslations } from "@shared/i18n"
import { getLocaleFromPath } from "@shared/lib/locale"
import SectionLabel from "@shared/ui/section-label"

const currentLocale = getLocaleFromPath(Astro.url.pathname)
const t = useTranslations(currentLocale)
const skills = getSkills(t)
---

<div id="skills" class="text-white w-full py-16 min-[624px]:py-32">
	<div class="flex flex-col gap-16">
		<div class="flex flex-col items-center gap-2">
			<SectionLabel>{t("skills.section")}</SectionLabel>
			<h2 class="text-center font-normal text-[16px] text-gray-400">
				{t("skills.title")}
			</h2>
		</div>
		<div class="flex flex-wrap justify-center gap-8">
			{
				skills.map(({ icon, title, technologies, description }) => (
					<SkillCard
						title={title}
						technologies={technologies}
						description={description}
						className="w-full md:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)]"
					>
						{icon === "tools" && <ToolIcon class="w-6 h-6" />}
						{icon === "frontend" && <PcIcon class="w-6 h-6" />}
						{icon === "testing" && <RocketIcon class="w-6 h-6" />}
					</SkillCard>
				))
			}
		</div>
	</div>
</div>
